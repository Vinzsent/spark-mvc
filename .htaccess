<IfModule mod_rewrite.c>
    RewriteEngine on
    # Always route the root request to public/
    RewriteRule ^$ public/ [L]
    # For all other paths: serve existing files/dirs directly (images, css, etc.)
    # Only unknown paths get routed through public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule (.*) public/$1 [L]
</IfModule>

